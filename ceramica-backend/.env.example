# ─── Core ────────────────────────────────────────────────────────────────────
ENVIRONMENT=development           # development | staging | production
SECRET_KEY=change-me-at-least-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Database ─────────────────────────────────────────────────────────────────
# Local SQLite (dev without Docker)
DATABASE_URL=sqlite+aiosqlite:///./ceramica.db

# PostgreSQL (Docker or Supabase)
# DATABASE_URL=postgresql+asyncpg://ceramica:ceramica@localhost:5432/ceramica_db

# Supabase (production)
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ─── Redis ────────────────────────────────────────────────────────────────────
# Local Redis
REDIS_URL=redis://localhost:6379/0

# Upstash (production)
# REDIS_URL=rediss://default:[YOUR-PASSWORD]@[YOUR-ENDPOINT].upstash.io:6380

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,tauri://localhost

# ─── Rate Limiting ────────────────────────────────────────────────────────────
AUTH_RATE_LIMIT_REQUESTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Business Rules ───────────────────────────────────────────────────────────
LOW_STOCK_THRESHOLD=5            # alert when stock drops below this
MAX_CLIENT_DEBT_CENTS=500000     # 5000.00 in local currency
